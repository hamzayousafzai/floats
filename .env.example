# Automated event ingestion (workers only). Names and safe nonsecret defaults.
# Never commit real credentials; set secrets in the runner environment.
INGESTION_CENTER_LAT=35.2271
INGESTION_CENTER_LNG=-80.8431
INGESTION_RADIUS_MILES=35
INGESTION_HORIZON_DAYS=60
INGESTION_MIN_VENDOR_COUNT=3
INGESTION_AUTO_PUBLISH_SCORE=90
INGESTION_REVIEW_SCORE=70
INGESTION_TIMEZONE=America/New_York
# shadow = record decisions only; live requires explicit operator approval.
INGESTION_PUBLISH_MODE=shadow
INGESTION_HTTP_TIMEOUT_MS=15000
INGESTION_MAX_RESPONSE_BYTES=2097152
INGESTION_MAX_CONCURRENCY=3
INGESTION_USER_AGENT="FloatsEventDiscovery/1.0 (+https://findfloats.com)"
# Use an ISOLATED/non-production project for local runs and tests.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
