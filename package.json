{
  "name": "floats",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "build:ci": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ingest:daily": "tsx scripts/ingestion/collect.ts",
    "ingest:discover": "tsx scripts/ingestion/discover.ts",
    "ingest:seed": "tsx scripts/ingestion/seed-sources.ts",
    "ingest:replay": "tsx scripts/ingestion/replay.ts",
    "ingest:verify": "tsx scripts/ingestion/verify.ts",
    "ingest:retain": "tsx scripts/ingestion/retain.ts",
    "ingest:staging-check": "tsx scripts/ingestion/staging-check.ts",
    "test:ingestion": "jest tests/ingestion --runInBand",
    "db:types": "npx supabase gen types typescript --project-id inxlsvowzpqvfulhbnou --schema public > lib/database.types.ts",
    "db:dump": "npx supabase db dump --workdir ..\\supabase --linked -f schema.sql",
    "db:dump:functions": "npx supabase db dump --workdir ..\\supabase --linked --role-only -f roles.sql",
    "db:pull": "npm run db:types && npm run db:dump && npm run db:dump:functions"
  },
  "dependencies": {
    "@react-email/render": "^2.0.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.7.0",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "ics": "^3.8.1",
    "lucide-react": "^0.542.0",
    "maplibre-gl": "^5.7.1",
    "next": "^15.5.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-easy-crop": "^5.5.0",
    "resend": "^6.4.2",
    "supercluster": "^8.0.1",
    "zod": "^4.6.7"
  },
  "daisyui": {
    "themes": [
      "light",
      "corporate",
      "forest"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "daisyui": "^5.1.7",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "playwright": "^1.55.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
